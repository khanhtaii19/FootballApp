+ */
+export async function getDescribeDb() {
+  try {
+    await prisma.$queryRaw`SELECT 1`;
+    return describe;
+  } catch (error) {
+    if (process.env.CI) {
+      throw new Error("Integration test cần database nhưng không kết nối được trong CI", {
+        cause: error,
+      });
+    }
+    return describe.skip;
+  }
+}
