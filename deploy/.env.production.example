# Sao chép thành .env ở thư mục gốc repo rồi điền giá trị thật:  cp deploy/.env.production.example .env
# KHÔNG commit file .env (đã nằm trong .gitignore).

# Tên miền (chỉ hostname, không có https://). Phải trỏ bản ghi A về IP máy chủ.
DOMAIN=sanbong.example.com

# Mật khẩu database. Dùng chuỗi hex để không có ký tự đặc biệt:  openssl rand -hex 24
POSTGRES_PASSWORD=thay-bang-chuoi-hex-ngau-nhien

# Khóa ký token đăng nhập, mỗi cái ít nhất 32 ký tự và KHÁC nhau:  openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-ngau-nhien-thu-nhat-dai-it-nhat-32-ky-tu
JWT_REFRESH_SECRET=thay-bang-chuoi-ngau-nhien-thu-hai-dai-it-nhat-32-ky-tu

# Tài khoản chủ sân, chỉ dùng ở lần khởi động đầu tiên (tạo xong có thể xóa hai dòng mật khẩu).
# Mật khẩu: ít nhất 12 ký tự, có chữ hoa, chữ thường và số.
SEED_OWNER_EMAIL=chusan@example.com
SEED_OWNER_PASSWORD=DoiMatKhauNayNgay2026

# Tùy chọn
# Chỉ cần nếu giao diện chạy ở domain khác với API (mặc định cùng domain, không cần CORS)
# CLIENT_URL=https://app.example.com
# MAX_PENDING_BOOKINGS_PER_USER=3
# EXPIRY_JOB_INTERVAL_SECONDS=60
