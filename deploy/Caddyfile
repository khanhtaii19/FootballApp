# Caddy: HTTPS tự động (Let's Encrypt), phục vụ giao diện và chuyển /api tới server.
#   DOMAIN=sanbong.example.com        -> HTTPS thật (domain phải trỏ về máy chủ, mở cổng 80/443)
#   DOMAIN=localhost                  -> HTTPS cục bộ với chứng chỉ tự ký (thử trên máy)
#   DOMAIN=http://localhost           -> HTTP thường (thử/CI, không có HTTPS)
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Giao diện chỉ tải script/kết nối từ chính domain này. 'unsafe-inline' chỉ cho style
		# vì lịch tổng định vị khối bằng thuộc tính style.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy server:3000
	}

	handle {
		root * /srv

		# File build có hash trong tên: cache lâu. index.html luôn kiểm tra lại.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		# Single-page app: đường dẫn không có file thì trả index.html
		try_files {path} /index.html
		file_server
	}
}
