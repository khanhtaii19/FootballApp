# Database
DATABASE_URL="postgresql://sanbong:sanbong_secret@localhost:5433/sanbong?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Client
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Giữ chỗ (booking pending)
# Số booking chờ thanh toán tối đa mỗi người (mặc định 3)
MAX_PENDING_BOOKINGS_PER_USER=3
# Chu kỳ job nhả booking quá hạn, tính bằng giây (mặc định 60)
EXPIRY_JOB_INTERVAL_SECONDS=60

# ─── Production ─────────────────────────────────────
# Ở NODE_ENV=production server từ chối khởi động nếu thiếu/yếu các giá trị sau.
# (Khi dùng docker-compose.prod.yml thì đặt trong file .env ở thư mục gốc, xem docs/DEPLOY.md)
#   JWT_SECRET, JWT_REFRESH_SECRET : ít nhất 32 ký tự, khác nhau, ngẫu nhiên (openssl rand -base64 48)
#   CLIENT_URL                     : https://... (nhiều domain cách nhau bằng dấu phẩy)
# Số proxy phía trước server (Caddy = 1). Mặc định: 1 ở production, tắt ở dev.
# TRUST_PROXY=1
# Tắt log từng request
# LOG_REQUESTS=false

# Tài khoản chủ sân khi chạy seed. Dev không cần đặt (có tài khoản demo).
# Production BẮT BUỘC: mật khẩu ≥ 12 ký tự, có chữ hoa, chữ thường, số.
# SEED_OWNER_EMAIL=chusan@example.com
# SEED_OWNER_PASSWORD=

