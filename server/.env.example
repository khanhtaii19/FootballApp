# Database
DATABASE_URL="postgresql://sanbong:sanbong_secret@localhost:5433/sanbong?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Client
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Giữ chỗ (booking pending)
# Số booking chờ thanh toán tối đa mỗi người (mặc định 3)
MAX_PENDING_BOOKINGS_PER_USER=3
# Chu kỳ job nhả booking quá hạn, tính bằng giây (mặc định 60)
EXPIRY_JOB_INTERVAL_SECONDS=60
